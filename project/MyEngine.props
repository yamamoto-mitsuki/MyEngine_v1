<?xml version="1.0" encoding="utf-8"?>
<!--
=============================================================================
 MyEngine.props
 MyEngine を使うプロジェクト（エンジン自身・ゲーム）が読み込む設定ファイル
 これを読むと、エンジンのヘッダーを"ModelManager.h"のようにファイル名だけで includeできる
=============================================================================
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- ===== 場所 ===== -->
	<PropertyGroup>
		<!-- このファイルがあるフォルダ（＝エンジンのリポジトリのルート。末尾に \ が付く） -->
		<MyEngineRoot>$(MSBuildThisFileDirectory)</MyEngineRoot>
		<!-- MyEngineフォルダの下のフォルダを全部集める。結果は ;区切りの1つの文字列 -->
		<MyEngineSubDirs>$([System.IO.Directory]::GetDirectories('$(MyEngineRoot)MyEngine','*',System.IO.SearchOption.AllDirectories))</MyEngineSubDirs>
	</PropertyGroup>

	<!-- ===== 出力先 ===== -->
	<Import Project="OutputDirs.props" />

	<!-- ===== 全部の構成で共通 ===== -->
	<ItemDefinitionGroup>
		<ClCompile>
			<!-- ~~~ インクルードディレクトリ ~~~ -->
			<!-- $(MyEngineRoot)        : "MyEngine/Graphics/Model/ModelManager.h・<externals/imgui/imgui.h> の書き方" -->
			<!-- $(MyEngineRoot)MyEngine: "Engine.h"用（GetDirectories は MyEngine自身を含まないので別に足す）-->
			<!-- $(MyEngineSubDirs)     : "ModelManager.h"のようにファイル名だけで書く用 -->
			<AdditionalIncludeDirectories>
				$(MyEngineRoot);$(MyEngineRoot)MyEngine;$(MyEngineSubDirs);$(MyEngineRoot)externals;$(MyEngineRoot)externals\assimp\include;
				%(AdditionalIncludeDirectories)
			</AdditionalIncludeDirectories>
			<!-- ~~~ エンジンとゲームで合わせる設定 ~~~ -->
			<LanguageStandard>stdcpp23</LanguageStandard>
			<AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
		</ClCompile>
	</ItemDefinitionGroup>


	<!-- ===== Debug ===== -->
	<ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
		<ClCompile>
			<RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
			<PreprocessorDefinitions>USE_IMGUI;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
		<Link>
			<AdditionalDependencies>assimp-vc143-mtd.lib;%(AdditionalDependencies)</AdditionalDependencies>
			<AdditionalLibraryDirectories>$(MyEngineRoot)externals\assimp\lib\Debug;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
		</Link>
	</ItemDefinitionGroup>

	<!-- ===== Debug以外 ===== -->
	<ItemDefinitionGroup Condition= "'$(Configuration)'!='Debug'">
		<ClCompile>
			<RuntimeLibrary>MultiThreaded</RuntimeLibrary>
		</ClCompile>
		<Link>
			<AdditionalDependencies>assimp-vc143-mt.lib;%(AdditionalDependencies)</AdditionalDependencies>
			<AdditionalLibraryDirectories>$(MyEngineRoot)externals\assimp\lib\Release;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
		</Link>

	</ItemDefinitionGroup>

    <!-- ===== ゲーム自身が参照するプロジェクト ===== -->
    <!-- エンジン自身もこの propsを読むので、MyEngine_v1の時は自分を参照してしまうので外す -->
    <ItemGroup Condition="'$(MSBuildProjectName)'!='MyEngine_v1'">
	  <ProjectReference Include="$(MyEngineRoot)MyEngine_v1.vcxproj">
	    <Project>{1d0f63d3-16bb-43b8-985e-6bb516a1d662}</Project>
	  </ProjectReference>
	  <ProjectReference Include="$(MyEngineRoot)externals\DirectXTex\DirectXTex_Desktop_2022_Win10.vcxproj">
	    <Project>{371b9fa9-4c90-4ac6-a123-aced756d6c77}</Project>
	  </ProjectReference>
	</ItemGroup>
	<!-- ImGui は Release では使わない（USE_IMGUI が無い）ので、Release 以外だけ -->
	<ItemGroup Condition="'$(MSBuildProjectName)'!='MyEngine_v1' and '$(Configuration)'!='Release'">
	  <ProjectReference Include="$(MyEngineRoot)externals\imgui\imgui.vcxproj">
	    <Project>{86a1cafe-73b6-4e0a-8c54-ef98278a3806}</Project>
	  </ProjectReference>
	</ItemGroup>

	<!-- ===== Development ===== -->
	<ItemDefinitionGroup Condition="'$(Configuration)'=='Development'">
		<ClCompile>
			<PreprocessorDefinitions>USE_IMGUI;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
	</ItemDefinitionGroup>

</Project>
