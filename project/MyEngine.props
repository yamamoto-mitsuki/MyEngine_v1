<?xml version="1.0" encoding="utf-8"?>
<!--
=============================================================================
 MyEngine.props
 MyEngine を使うプロジェクト（エンジン自身・ゲーム）が読み込む設定ファイル
 これを読むと、エンジンのヘッダーを"ModelManager.h"のようにファイル名だけで includeできる
=============================================================================
-->
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

	<!-- ===== 場所 ===== -->
	<PropertyGroup>
		<!-- このファイルがあるフォルダ（＝エンジンのリポジトリのルート。末尾に \ が付く） -->
		<MyEngineRoot>$(MSBuildThisFileDirectory)</MyEngineRoot>
		<!-- vcpkgが外部ライブラリを入れる先（externalsの下。.gitignoreでgitには入らない。末尾に\を付けない）-->
		<VcpkgInstallRoot>$(MyEngineRoot)externals\vcpkg_installed</VcpkgInstallRoot>
		<!-- x64-windows-static：64 ビット・lib に全部入れる形・/MT（エンジンの RuntimeLibrary と同じ）-->
		<VcpkgPackageDir>$(VcpkgInstallRoot)\x64-windows-static\</VcpkgPackageDir>
		<!-- MyEngineフォルダの下のフォルダを全部集める。結果は ;区切りの1つの文字列 -->
		<MyEngineSubDirs>$([System.IO.Directory]::GetDirectories('$(MyEngineRoot)MyEngine','*',System.IO.SearchOption.AllDirectories))</MyEngineSubDirs>
	</PropertyGroup>

	<!-- ===== 出力先 ===== -->
	<Import Project="OutputDirs.props" />

	<!-- ===== 全部の構成で共通 ===== -->
	<ItemDefinitionGroup>
		<ClCompile>
			<!-- ~~~ インクルードディレクトリ ~~~ -->
			<!-- $(MyEngineRoot)        : "MyEngine/Graphics/Model/ModelManager.h・<externals/imgui/imgui.h> の書き方" -->
			<!-- $(MyEngineRoot)MyEngine: "Engine.h"用（GetDirectories は MyEngine自身を含まないので別に足す）-->
			<!-- $(MyEngineSubDirs)     : "ModelManager.h"のようにファイル名だけで書く用 -->
			<AdditionalIncludeDirectories>
				$(MyEngineRoot);$(MyEngineRoot)MyEngine;$(MyEngineSubDirs);$(MyEngineRoot)externals;$(MyEngineRoot)externals\imgui;$(VcpkgPackageDir)include;
				%(AdditionalIncludeDirectories)
			</AdditionalIncludeDirectories>
			<!-- ~~~ エンジンとゲームで合わせる設定 ~~~ -->
			<LanguageStandard>stdcpp23</LanguageStandard>
			<AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
			<!-- NOMINMAX : Windows.h の min・max マクロを止める（std::max とぶつかるため）。ファイルごとに #define しない -->
			<!-- DIRECTINPUT_VERSION : dinput.h の前に決めておく必要があるので、ファイルごとに #define しない -->
			<PreprocessorDefinitions>NOMINMAX;DIRECTINPUT_VERSION=0x0800;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
	</ItemDefinitionGroup>


	<!-- ===== Debug ===== -->
	<ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
		<ClCompile>
			<RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
			<PreprocessorDefinitions>USE_IMGUI;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
		<Link>
			<AdditionalDependencies>assimp-vc145-mtd.lib;kubazip.lib;minizipsd.lib;poly2tri.lib;polyclipping.lib;pugixml.lib;zsd.lib;%(AdditionalDependencies)</AdditionalDependencies>
			<AdditionalLibraryDirectories>$(VcpkgPackageDir)debug\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
		</Link>
	</ItemDefinitionGroup>

	<!-- ===== Debug以外 ===== -->
	<ItemDefinitionGroup Condition= "'$(Configuration)'!='Debug'">
		<ClCompile>
			<RuntimeLibrary>MultiThreaded</RuntimeLibrary>
		</ClCompile>
		<Link>
			<AdditionalDependencies>assimp-vc145-mt.lib;kubazip.lib;minizips.lib;poly2tri.lib;polyclipping.lib;pugixml.lib;zs.lib;%(AdditionalDependencies)</AdditionalDependencies>
			<AdditionalLibraryDirectories>$(VcpkgPackageDir)lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
		</Link>

	</ItemDefinitionGroup>

    <!-- ===== ゲーム自身が参照するプロジェクト ===== -->
    <!-- エンジン自身もこの propsを読むので、MyEngine_v1の時は自分を参照してしまうので外す -->
    <ItemGroup Condition="'$(MSBuildProjectName)'!='MyEngine_v1'">
	  <ProjectReference Include="$(MyEngineRoot)MyEngine_v1.vcxproj">
	    <Project>{1d0f63d3-16bb-43b8-985e-6bb516a1d662}</Project>
	  </ProjectReference>
	  <ProjectReference Include="$(MyEngineRoot)externals\DirectXTex\DirectXTex_Desktop_2022_Win10.vcxproj">
	    <Project>{371b9fa9-4c90-4ac6-a123-aced756d6c77}</Project>
	  </ProjectReference>
	</ItemGroup>
	<!-- ImGui は Release では使わない（USE_IMGUI が無い）ので、Release 以外だけ -->
	<ItemGroup Condition="'$(MSBuildProjectName)'!='MyEngine_v1' and '$(Configuration)'!='Release'">
	  <ProjectReference Include="$(MyEngineRoot)externals\imgui\imgui.vcxproj">
	    <Project>{86a1cafe-73b6-4e0a-8c54-ef98278a3806}</Project>
	  </ProjectReference>
	</ItemGroup>

	<!-- ===== Release以外 ===== -->
	<!-- エンジンのフォルダの場所をコードに渡す -->
	<ItemDefinitionGroup Condition="'$(Configuration)'!='Release'">
		<ClCompile>
			<PreprocessorDefinitions>MYENGINE_ROOT_DIR=LR"($(MyEngineRoot))";%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
	</ItemDefinitionGroup>

	<!-- ===== Development ===== -->
	<ItemDefinitionGroup Condition="'$(Configuration)'=='Development'">
		<ClCompile>
			<PreprocessorDefinitions>USE_IMGUI;%(PreprocessorDefinitions)</PreprocessorDefinitions>
		</ClCompile>
	</ItemDefinitionGroup>

	<!-- ===== vcpkg ===== -->
	<!-- vcpkg.jsonに書いたライブラリを、コンパイラの前に入れる。 -->
	<Target Name="InstallVcpkgPackages" BeforeTargets="ClCompile" 
	Inputs="$(MyEngineRoot)externals\vcpkg.json;$(MyEngineRoot)externals\vcpkg-configuration.json"
	Outputs="$(VcpkgInstallRoot)\vcpkg\manifest-info.json">
	    <Error Condition="!Exists('$(VCInstallDir)vcpkg\vcpkg.exe')" Text="Visual Studioに vcpkg がありません。Visual Studio Installerで「vcpkgパッケージマネージャー」を入れてください。"/>
        <Exec Command="&quot;$(VCInstallDir)vcpkg\vcpkg.exe&quot; install --triplet x64-windows-static --clean-after-build --x-manifest-root=&quot;$(MyEngineRoot)externals&quot; --x-install-root=&quot;$(VcpkgInstallRoot)&quot;" />
	</Target>
</Project>